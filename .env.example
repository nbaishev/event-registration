# Local development defaults only; do not reuse in production.
APP_ORIGIN=http://localhost:8080
APP_PORT=8080
ENVIRONMENT=development
POSTGRES_USER=event_registration
POSTGRES_PASSWORD=development
POSTGRES_DB=event_registration
# Generated locally by make bootstrap; provide an explicit random secret in production.
JWT_SECRET=

# Development/test only: Redis broker and Mailpit SMTP sink.
REDIS_URL=redis://redis:6379/0
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=tickets@example.com
SMTP_SECURITY=none
SMTP_TIMEOUT_SECONDS=10
# Optional SMTP_USERNAME / SMTP_PASSWORD: configure both via the environment.
# Authentication requires SMTP_SECURITY=starttls or tls; production values stay outside Git.
