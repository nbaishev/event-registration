# Temporary VPS deployment over HTTP. Not the backend production security mode.
# compose.prod.yaml deliberately sets ENVIRONMENT=development for HTTP cookies.
# Copy to .env.prod, chmod 600, and fill all empty required values before launch.
APP_ORIGIN=http://events.example.com
APP_PORT=80
# Tag built application images with the deployed Git revision.
APP_IMAGE_TAG=latest

POSTGRES_USER=event_registration
POSTGRES_DB=event_registration
POSTGRES_PASSWORD=
# At least 32 random bytes; generate separately from the DB password.
JWT_SECRET=

# Authenticated external SMTP relay; Mailpit is not included.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=tickets@example.com
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
SMTP_USERNAME=
SMTP_PASSWORD=
# For implicit TLS use SMTP_SECURITY=tls and your relay's TLS port (usually 465).
# Single-quote values containing $ or # to preserve them literally in Compose env files.
